{
  "name": "another-today",
  "version": "0.3.0",
  "private": true,
  "description": "另一个今天 · An offline pixel life companion",
  "author": "Another Today",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs && node scripts/build-electron.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac zip --arm64",
    "dist:win": "npm run build && electron-builder --win zip --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64",
    "dist:win:installer": "npm run build && electron-builder --win nsis portable --x64",
    "audit:balance": "esbuild scripts/balance-audit.ts --bundle --platform=node --format=esm --outfile=dist-electron/balance.mjs && node dist-electron/balance.mjs",
    "format": "prettier --write src electron scripts tests *.ts *.json *.html",
    "format:check": "prettier --check src electron scripts tests *.ts *.json *.html",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "build:web": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "test:web": "npm run build:web && playwright test --config playwright.web.config.ts",
    "audit:living": "esbuild scripts/living-audit.ts --bundle --platform=node --format=esm --outfile=dist-electron/living-audit.mjs && node dist-electron/living-audit.mjs",
    "audit:randomness": "esbuild scripts/random-life-audit.ts --bundle --platform=node --format=esm --outfile=dist-electron/random-life-audit.mjs && node dist-electron/random-life-audit.mjs",
    "audit:careers": "esbuild scripts/career-audit.ts --bundle --platform=node --format=esm --outfile=dist-electron/career-audit.mjs && node dist-electron/career-audit.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "studio.anothertoday.game",
    "productName": "Another Today",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "dist-electron/main.cjs",
      "dist-electron/preload.cjs"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.simulation-games",
      "target": [
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "extraFiles": [
      {
        "from": "README.md",
        "to": "README-中文.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  },
  "engines": {
    "node": ">=22.12 <26"
  }
}
